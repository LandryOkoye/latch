# --- AWS / Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Email transport (dedicated Gmail, App Password) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Google Sheets (counterparty system of record) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=

# --- Telegram (secondary pursuit channel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Attendee (meeting ingestion, optional) ---
ATTENDEE_API_KEY=

# --- Ledger ---
LATCH_DB_PATH=./latch.db

# --- Testing only: a second real inbox standing in for "the counterparty",
# used to verify real delivery (D2-T5) and later to send real replies back
# for adjudication testing (Day 3). Not read by the product itself. ---
TEST_COUNTERPARTY_EMAIL_ADDRESS=
TEST_COUNTERPARTY_EMAIL_APP_PASSWORD=
